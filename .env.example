# OneHealth — Frontend. Copiare in `.env` solo se il Backend non gira sui valori di default.

# Dove risponde il server del Backend: Vite gira qui ogni chiamata /api/*
ONEHEALTH_API_URL=http://127.0.0.1:8000

# Facoltativa: porta della dashboard (default 5173; se la cambi, aggiungi l'origine a ONEHEALTH_ORIGINI del Backend)
# ONEHEALTH_DASHBOARD_PORT=5173
